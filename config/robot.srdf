<?xml version='1.0' encoding='utf-8'?>
<robot name="frontec_arm">
	<group name="arm_group">
		<joint name="joint_a1" />
		<joint name="joint_a2" />
		<joint name="joint_a3" />
		<joint name="joint_a4" />
		<joint name="joint_a5" />
		<joint name="joint_a6" />
	</group>
	<virtual_joint name="virtual_joint" type="floating" parent_frame="base_arm" child_link="base_link" />
	<disable_collisions link1="base_arm" link2="link_1" reason="Adjacent" />
	<disable_collisions link1="base_arm" link2="link_2" reason="Never" />
	<disable_collisions link1="base_arm" link2="link_3" reason="Never" />
	<disable_collisions link1="link_1" link2="link_2" reason="Adjacent" />
	<disable_collisions link1="link_1" link2="link_3" reason="Never" />
	<disable_collisions link1="link_2" link2="link_3" reason="Adjacent" />
	<disable_collisions link1="link_2" link2="link_4" reason="Never" />
	<disable_collisions link1="link_3" link2="link_4" reason="Adjacent" />
	<disable_collisions link1="link_3" link2="link_5" reason="Never" />
	<disable_collisions link1="link_3" link2="link_6" reason="Never" />
	<disable_collisions link1="link_4" link2="link_5" reason="Adjacent" />
	<disable_collisions link1="link_4" link2="link_6" reason="Never" />
	<disable_collisions link1="link_4" link2="tool0" reason="Never" />
	<disable_collisions link1="link_5" link2="link_6" reason="Adjacent" />
	<disable_collisions link1="link_5" link2="tool0" reason="Never" />
	<disable_collisions link1="link_6" link2="tool0" reason="Adjacent" />
</robot>
